# ============================================================================
# PATCHBOUNTY // @aegis — ENVIRONMENT CONFIGURATION
# ============================================================================
# Required: Single ASI:One API Key (powers 50/50 Dual Load Balancer: asi1 + asi1-mini)
ASI_ONE_API_KEY=your_asi_one_api_key_here
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_ROUTING_MODE=dual_round_robin

# Optional: Higher GitHub Public REST API rate limit for large repository scans
GITHUB_TOKEN=

# Optional: Change this string anytime to generate a brand-new @aegis address + Mailbox URL for another email account!
AEGIS_SEED=patchbounty-aegis-command-coordinator-v3

# Optional: Agentverse Mailbox API Key (or connect via printed Inspector URL)
AGENTVERSE_API_KEY=
NVD_API_KEY=   # Optional (free): https://nvd.nist.gov/developers/request-an-api-key — NVD live data aur tez/stable ho jayega

# Optional: Post-payment auto email ke liye SMTP (Gmail App Password chalega)
# Na lagao to bhi report + ready .eml draft download ban jata hai (jhootha send nahi hota)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_PASS=
